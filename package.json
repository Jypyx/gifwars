{
  "name": "gif-wars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assets": "node scripts/generate-icons.mjs && node scripts/generate-gifs.mjs",
    "build": "vue-tsc -b && vite build",
    "build:pages": "vue-tsc -b && vite build --mode github-pages",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "vite preview --mode github-pages --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "pixi.js": "^8.14.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.8",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0"
  },
  "engines": { "node": ">=22.12.0" }
}
